* { font-family: "Segoe UI"; font-size: 14px; color: #1d2327; }
QMainWindow, QStackedWidget { background: #f0f0f1; }
#topBar { background: #2271b1; min-height: 54px; max-height: 54px; }
#logo { color: white; font-size: 21px; font-weight: 700; padding-left: 12px; }
#topButton { color: white; background: transparent; border: 1px solid rgba(255,255,255,0.5); padding: 7px 14px; }
#topButton:hover { background: #135e96; }
#sidebar { background: #1d2327; color: white; border: 0; padding-top: 14px; outline: 0; }
#sidebar::item { color: white; padding: 14px 18px; border-left: 4px solid transparent; }
#sidebar::item:hover { background: #2c3338; }
#sidebar::item:selected { background: #2271b1; border-left-color: #72aee6; }
#pageTitle { font-size: 25px; font-weight: 600; margin-bottom: 8px; }
#card { background: white; border: 1px solid #c3c4c7; border-radius: 3px; padding: 16px; }
QLineEdit, QTextEdit, QDateTimeEdit, QTableWidget, QTabWidget::pane { background: white; border: 1px solid #8c8f94; border-radius: 3px; padding: 6px; }
QLineEdit:focus, QTextEdit:focus, QDateTimeEdit:focus { border: 2px solid #2271b1; }
QPushButton { background: #f6f7f7; border: 1px solid #2271b1; color: #2271b1; border-radius: 3px; padding: 7px 13px; }
QPushButton:hover { background: #f0f6fc; border-color: #135e96; color: #135e96; }
QPushButton:disabled { border-color: #c3c4c7; color: #a7aaad; }
#primaryButton { background: #2271b1; color: white; font-weight: 600; padding: 9px 18px; }
#primaryButton:hover { background: #135e96; }
#formatButton { min-width: 30px; max-width: 70px; font-weight: 600; }
#mediaUploader { background: #f6f7f7; border: 2px dashed #c3c4c7; border-radius: 4px; }
#mediaCard { background: white; border: 1px solid #c3c4c7; border-radius: 3px; }
#platformCheck { spacing: 8px; padding: 8px 14px; background: white; border: 1px solid #c3c4c7; border-radius: 3px; }
QHeaderView::section { background: #f6f7f7; border: 0; border-bottom: 1px solid #c3c4c7; padding: 9px; font-weight: 600; }
QTableWidget { gridline-color: #dcdcde; }
QTabBar::tab { background: #dcdcde; padding: 10px 16px; }
QTabBar::tab:selected { background: white; color: #2271b1; }
QProgressBar { border: 1px solid #c3c4c7; background: white; text-align: center; min-height: 20px; }
QProgressBar::chunk { background: #00a32a; }
